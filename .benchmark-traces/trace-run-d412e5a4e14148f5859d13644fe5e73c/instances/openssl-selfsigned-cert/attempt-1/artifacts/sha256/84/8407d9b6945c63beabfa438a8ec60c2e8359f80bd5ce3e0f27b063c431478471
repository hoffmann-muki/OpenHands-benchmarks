{"command":"create","content":[{"cache_prompt":false,"text":"File created successfully at: /app/check_cert.py","type":"text"}],"is_error":false,"kind":"FileEditorObservation","new_content":"#!/usr/bin/env python3\n\"\"\"Verify the self-signed TLS certificate exists and can be loaded.\"\"\"\n\nimport os\nimport sys\nfrom datetime import datetime\n\nCERT_PATH = \"/app/ssl/server.crt\"\n\n\ndef main():\n    # Verify the certificate file exists\n    if not os.path.exists(CERT_PATH):\n        print(f\"ERROR: Certificate file not found at {CERT_PATH}\")\n        sys.exit(1)\n\n    # Load the certificate using OpenSSL's cryptography library\n    try:\n        from cryptography import x509\n        from cryptography.hazmat.backends import default_backend\n    except ImportError:\n        print(\"ERROR: 'cryptography' library is not installed.\")\n        sys.exit(1)\n\n    try:\n        with open(CERT_PATH, \"rb\") as f:\n            cert_data = f.read()\n        cert = x509.load_pem_x509_certificate(cert_data, default_backend())\n    except Exception as e:\n        print(f\"ERROR: Failed to load certificate: {e}\")\n        sys.exit(1)\n\n    # Extract Common Name\n    subject = cert.subject\n    common_name = None\n    for attr in subject:\n        if attr.oid._name == \"commonName\":\n            common_name = attr.value\n            break\n\n    if common_name is None:\n        print(\"ERROR: Common Name not found in certificate subject.\")\n        sys.exit(1)\n\n    # Extract expiration date and format as YYYY-MM-DD\n    not_after = cert.not_valid_after_utc\n    expiration_date = not_after.strftime(\"%Y-%m-%d\")\n\n    print(f\"Common Name: {common_name}\")\n    print(f\"Expiration Date: {expiration_date}\")\n    print(\"Certificate verification successful\")\n\n\nif __name__ == \"__main__\":\n    main()\n","path":"/app/check_cert.py","prev_exist":false}
