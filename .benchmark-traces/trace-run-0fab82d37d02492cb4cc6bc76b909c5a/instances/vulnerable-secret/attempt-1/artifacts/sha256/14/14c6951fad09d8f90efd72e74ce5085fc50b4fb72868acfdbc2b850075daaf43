{"command":"python3 << 'EOF'\nimport struct\n\n# Read the executable\nwith open('/app/vulnerable', 'rb') as f:\n    data = f.read()\n\n# Check for ELF header\nif data[:4] != b'\\x7fELF':\n    print(\"Not an ELF file\")\n    exit(1)\n\n# Parse ELF header (64-bit)\nelf_header = struct.unpack('<16sHHIQQQIHHHHHH', data[:64])\ne_phoff = elf_header[5]  # Program header offset\ne_shoff = elf_header[6]  # Section header offset\ne_phentsize = elf_header[10]  # Program header entry size\ne_phnum = elf_header[11]  # Number of program headers\ne_shentsize = elf_header[12]  # Section header entry size\ne_shnum = elf_header[13]  # Number of section headers\ne_shstrndx = elf_header[15]  # Section header string table index\n\nprint(f\"ELF Header parsed:\")\nprint(f\"  Section header offset: {e_shoff}\")\nprint(f\"  Section header entry size: {e_shentsize}\")\nprint(f\"  Number of sections: {e_shnum}\")\n\n# Read section headers\nsections = []\nfor i in range(e_shnum):\n    offset = e_shoff + i * e_shentsize\n    sh = struct.unpack('<IIQQQQIIQQ', data[offset:offset + e_shentsize])\n    sections.append({\n        'name_idx': sh[0],\n        'type': sh[1],\n        'flags': sh[2],\n        'addr': sh[3],\n        'offset': sh[4],\n        'size': sh[5],\n        'link': sh[6],\n        'info': sh[7],\n        'addralign': sh[8],\n        'entsize': sh[9]\n    })\n\n# Read section header string table\nshstrtab_section = sections[e_shstrndx]\nshstrtab = data[shstrtab_section['offset']:shstrtab_section['offset'] + shstrtab_section['size']].split(b'\\x00')\n\n# Find .data section\nfor i, section in enumerate(sections):\n    name = shstrtab[section['name_idx']].decode('ascii', errors='replace') if section['name_idx'] < len(shstrtab) else ''\n    if name == '.data':\n        print(f\"\\nFound .data section:\")\n        print(f\"  Offset: {section['offset']}\")\n        print(f\"  Size: {section['size']}\")\n        \n        # Read and XOR decrypt .data section\n        data_section = data[section['offset']:section['offset'] + section['size']]\n        key = 0x42\n        decrypted = bytes([b ^ key for b in data_section])\n        \n        print(f\"\\nDecrypted .data content:\")\n        print(decrypted.decode('latin-1'))\n        \n        # Look for FLAG pattern\n        import re\n        matches = re.findall(b'FLAG\\{[^}]+\\}', decrypted)\n        for m in matches:\n            print(f\"\\nFound flag: {m.decode('utf-8', errors='replace')}\")\nEOF","is_input":false,"kind":"TerminalAction","reset":false}
