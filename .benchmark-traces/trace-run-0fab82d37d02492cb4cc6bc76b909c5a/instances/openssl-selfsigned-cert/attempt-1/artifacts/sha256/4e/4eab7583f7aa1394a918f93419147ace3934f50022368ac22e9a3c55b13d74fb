{"command":"create","file_text":"#!/usr/bin/env python3\n\"\"\"Certificate verification script.\"\"\"\n\nimport os\nfrom datetime import datetime\nfrom cryptography import x509\nfrom cryptography.hazmat.backends import default_backend\n\n\ndef load_certificate(cert_path):\n    \"\"\"Load and return the certificate from the given path.\"\"\"\n    with open(cert_path, \"rb\") as cert_file:\n        return x509.load_pem_x509_certificate(cert_file.read(), default_backend())\n\n\ndef main():\n    cert_path = \"/app/ssl/server.crt\"\n    \n    try:\n        # Verify certificate exists and can be loaded\n        if not os.path.exists(cert_path):\n            print(f\"Error: Certificate file not found at {cert_path}\")\n            return\n        \n        cert = load_certificate(cert_path)\n        \n        # Get certificate details\n        subject = cert.subject\n        common_name = subject.get_attributes_for_oid(x509.oid.NameOID.COMMON_NAME)[0].value\n        expiration_date = cert.not_valid_after_utc\n        \n        # Format expiration date as YYYY-MM-DD\n        expiration_formatted = expiration_date.strftime(\"%Y-%m-%d\")\n        \n        print(f\"Certificate Details:\")\n        print(f\"  Common Name: {common_name}\")\n        print(f\"  Expiration Date: {expiration_formatted}\")\n        \n        # Additional verification checks\n        if cert.not_valid_before_utc > datetime.now(cert.not_valid_before_utc.tzinfo):\n            print(\"Error: Certificate is not yet valid\")\n            return\n        \n        if cert.not_valid_after_utc < datetime.now(cert.not_valid_after_utc.tzinfo):\n            print(\"Error: Certificate has expired\")\n            return\n        \n        print(\"Certificate verification successful\")\n        \n    except FileNotFoundError:\n        print(f\"Error: Certificate file not found at {cert_path}\")\n    except Exception as e:\n        print(f\"Error loading certificate: {e}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","kind":"FileEditorAction","path":"/app/check_cert.py"}
