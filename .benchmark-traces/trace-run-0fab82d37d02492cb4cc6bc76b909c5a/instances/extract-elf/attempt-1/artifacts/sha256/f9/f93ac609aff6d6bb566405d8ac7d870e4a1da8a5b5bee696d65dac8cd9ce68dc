{"command":"node -e \"\nconst fs = require('fs');\nconst buffer = fs.readFileSync('/app/a.out');\nconst shOff = 13976;\nconst shNum = 31;\nconst shEntSize = 64;\nconst shNameStrIdx = 30;\n\n// Read section headers\nconst sections = [];\nfor (let i = 0; i < shNum; i++) {\n    const offset = shOff + i * shEntSize;\n    const sh_name = buffer.readUInt32LE(offset);\n    const sh_type = buffer.readUInt32LE(offset + 4);\n    const sh_addr = buffer.readUInt32LE(offset + 16) | (buffer.readUInt32LE(offset + 20) << 32);\n    const sh_offset = buffer.readUInt32LE(offset + 24) | (buffer.readUInt32LE(offset + 28) << 32);\n    const sh_size = buffer.readUInt32LE(offset + 32) | (buffer.readUInt32LE(offset + 36) << 32);\n    \n    sections.push({ name: sh_name, type: sh_type, addr: sh_addr, offset: sh_offset, size: sh_size });\n}\n\nconsole.log('shstrtab section:', shNameStrIdx);\nconsole.log('shstrtab offset:', sections[shNameStrIdx].offset);\nconsole.log('shstrtab size:', sections[shNameStrIdx].size);\n\nconst nameBuffer = buffer.slice(sections[shNameStrIdx].offset, sections[shNameStrIdx].offset + sections[shNameStrIdx].size);\nconsole.log('Name buffer length:', nameBuffer.length);\nconsole.log('First 50 bytes:', Array.from(nameBuffer.slice(0, 50)).join(','));\n\"","is_input":false,"kind":"TerminalAction","reset":false}
