{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benchmark-trace:schema:v1:execution-tree",
  "title": "Benchmark Trace v1 execution tree",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_digest",
    "format",
    "trace_id",
    "run_id",
    "benchmark",
    "framework",
    "instance_id",
    "attempt",
    "generated_at",
    "complete",
    "source",
    "root",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/schema_version"
    },
    "schema_digest": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/schema_digest"
    },
    "format": {
      "const": "benchmark-trace/execution-tree-v1"
    },
    "trace_id": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
    },
    "run_id": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
    },
    "benchmark": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/slug"
    },
    "framework": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/slug"
    },
    "instance_id": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
    },
    "complete": {
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "root": {
      "$ref": "#/$defs/root"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "event_count",
        "represented_event_count"
      ],
      "properties": {
        "path": {
          "const": "events.jsonl"
        },
        "sha256": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/schema_digest"
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "represented_event_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "started_at",
        "ended_at",
        "duration_ms",
        "children"
      ],
      "properties": {
        "node_id": {
          "const": "trace-root"
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "oneOf": [
            {
              "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "event_type",
        "event_family",
        "status",
        "span_id",
        "source_event_ids",
        "source_sequences",
        "started_at",
        "ended_at",
        "duration_ms",
        "timing_fidelity",
        "completeness",
        "actor",
        "boundaries",
        "overlaps_with",
        "children"
      ],
      "properties": {
        "node_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "activity",
            "instant",
            "start_only",
            "end_only"
          ]
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 128
        },
        "event_family": {
          "enum": [
            "run",
            "instance",
            "attempt",
            "harness",
            "container",
            "evaluator",
            "agent",
            "model",
            "provider",
            "tool",
            "shell",
            "file",
            "search",
            "browser",
            "delegation",
            "context",
            "memory",
            "patch",
            "trace"
          ]
        },
        "status": {
          "enum": [
            "started",
            "completed",
            "failed",
            "cancelled",
            "timeout",
            "degraded",
            "unknown"
          ]
        },
        "span_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "parent_span_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
          }
        },
        "source_sequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "oneOf": [
            {
              "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "timing_fidelity": {
          "enum": [
            "native_monotonic",
            "native_wall",
            "derived",
            "not_available"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "instant",
            "start_only",
            "end_only"
          ]
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/boundary"
          }
        },
        "input": {
          "$ref": "#/$defs/content"
        },
        "output": {
          "$ref": "#/$defs/content"
        },
        "data": {
          "$ref": "#/$defs/content"
        },
        "concurrency_group": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "overlaps_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "agent_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "parent_agent_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "turn_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_type",
        "phase",
        "status",
        "occurred_at",
        "recorded_at",
        "origin",
        "timing"
      ],
      "properties": {
        "event_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 128
        },
        "phase": {
          "enum": [
            "start",
            "end",
            "instant"
          ]
        },
        "status": {
          "enum": [
            "started",
            "completed",
            "failed",
            "cancelled",
            "timeout",
            "degraded",
            "unknown"
          ]
        },
        "occurred_at": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
        },
        "recorded_at": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timestamp"
        },
        "origin": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/origin"
        },
        "timing": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/timing"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "event_id"
            ],
            "properties": {
              "type": {
                "enum": [
                  "caused_by",
                  "contains",
                  "derived_from",
                  "native_evidence",
                  "retry_of"
                ]
              },
              "event_id": {
                "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "artifacts"
      ],
      "properties": {
        "payload": {
          "type": "object"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/artifact_ref"
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "message": {
              "type": "string"
            },
            "artifact": {
              "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/artifact_ref"
            }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "event_id",
        "span_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        },
        "span_id": {
          "$ref": "urn:benchmark-trace:schema:v1:definitions#/$defs/identifier"
        }
      }
    }
  }
}
